# ---------------------------------------------------------------------------
# CampVoice environment variables
#
# Copy this file to `.env.local` and fill it in. `.env.local` is git-ignored and
# must NEVER be committed.
#
# Anything starting with NEXT_PUBLIC_ is visible to anyone who opens the site.
# Everything else is server-only and must stay secret.
# ---------------------------------------------------------------------------

# --- Where the site lives (used for links in emails and Stripe redirects) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase: database, sign-in and file storage -------------------------
# Find these in Supabase → your project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role key bypasses all security rules. Server-only. Never share it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed if your server URL differs from the public one.
SUPABASE_URL=

# --- Anthropic: the AI that writes the content ----------------------------
# Find this at console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Optional: change which model writes the content. Defaults shown.
# AI_GENERATION_MODEL=claude-opus-5
# AI_UTILITY_MODEL=claude-opus-5
# AI_MAX_OUTPUT_TOKENS=2000
# AI_MAX_CONTEXT_CHARS=24000

# --- Stripe: subscriptions ------------------------------------------------
# Test keys start sk_test_ / price_. Live keys start sk_live_.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# From Stripe → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=

# --- Free trial -----------------------------------------------------------
TRIAL_DAYS=14
# true = a card is required to start the trial. false = no card needed.
TRIAL_REQUIRE_CARD=false

# --- Pricing shown on the marketing site ----------------------------------
# These are display values only. The real charge comes from the Stripe Price.
NEXT_PUBLIC_PRICE_MONTHLY=79
NEXT_PUBLIC_PRICE_ANNUAL=699

# --- Support + analytics --------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=support@campvoice.com
# none | console | vercel
NEXT_PUBLIC_ANALYTICS_PROVIDER=none

# --- Fair-use limits (protects you from a runaway AI bill) ----------------
# LIMIT_GENERATIONS_PER_DAY=120
# LIMIT_GENERATIONS_PER_MINUTE=8
# LIMIT_MAX_UPLOAD_BYTES=8388608
